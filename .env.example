# Copy to .env (git-ignored, chmod 600) and fill in. Never commit .env or paste its values anywhere.

# --- Models: any OpenAI-compatible gateway (tested with LiteLLM). Use a service account's key for pipelines.
LITELLM_BASE_URL=https://<your model gateway>
LITELLM_API_KEY=
FAIR_LLM_KEY=                       # optional: the key the pipeline uses, if different from LITELLM_API_KEY
FAIR_CHAT_MODEL=<chat model name>   # must be able to return a JSON object
FAIR_EMBED_MODEL=<embedding model>  # 1024-dimension embeddings (fairdemo/catalog.py DIM), e.g. Qwen3-Embedding-0.6B or BGE-M3
FAIR_MODEL_LABEL=                   # optional: the model's public name in published records (FAIR_CHAT_MODEL may be a gateway alias)

# --- VAST cluster
VMS_ADMIN_USER=admin
VMS_ADMIN_PASSWORD=
FAIR_TENANT=fair                    # the tenant the setup creates; everything it creates is inside it
FAIR_TENANT_ADMIN_PASSWORD=         # optional: otherwise one is generated and kept in the state file

CLUSTER_VMS=https://<vms address>
CLUSTER_PROTOCOLS_VIPS=<first>-<last>        # S3 + VAST DB, unused addresses on the data network
CLUSTER_BROKER_VIPS=<first>-<last>           # VAST Event Broker, at least one per CNode, dedicated
CLUSTER_VIP_CIDR=24                          # prefix length of the data network
CLUSTER_REGISTRY=<registry host:port>        # HTTPS with a valid certificate, reachable by your Kubernetes nodes
CLUSTER_REGISTRY_PREFIX=<your name or team>  # images go to <registry>/<prefix>/fair-curate and fair-portal
CLUSTER_KUBECONFIG=~/.kube/<your cluster>.yaml
CLUSTER_K8S_NAME=fair-k8s
CLUSTER_K8S_API=https://<api server>:6443    # reachable from VMS
CLUSTER_K8S_NAMESPACE=fair-dataengine
CLUSTER_LANDING_BASE_URL=http://<portal host>:30080/id   # the name others will use: it is written into every published record
# CLUSTER_STATE_FILE=.state.json             # under deploy/; keys and passwords created by the setup
# CLUSTER_HTTPS_PROXY=http://<proxy>:<port>  # only if pods can't reach the model gateway directly
# CLUSTER_VAST_BUILDER=vastdataorg/vast-builder:v5.5.0-sp2   # match the vastde version you installed

# --- Local scripts that talk to S3 directly (scripts/scorecard.py without --portal)
# FAIR_S3_ENDPOINT=http://<S3 VIP>
